{
  "name": "cdr-ipdr-analyzer",
  "version": "1.0.0",
  "private": true,
  "author": "AlgoRhythm",
  "description": "CDR & IPDR Analysis Platform",
  "dependencies": {
    "@material-ui/core": "^4.11.0",
    "@material-ui/icons": "^4.9.1",
    "@types/react": "16.9.23",
    "axios": "^0.19.2",
    "chart.js": "^2.9.3",
    "classnames": "^2.2.6",
    "colorette": "^1.2.1",
    "d3-graph": "0.0.2",
    "history": "4.10.1",
    "leaflet": "^1.9.4",
    "perfect-scrollbar": "1.5.0",
    "prop-types": "15.7.2",
    "react": "16.13.0",
    "react-chartjs-2": "^2.9.0",
    "react-d3-graph": "^2.5.0",
    "react-datetime-bootstrap": "^1.4.7",
    "react-dom": "16.13.0",
    "react-google-maps": "9.4.5",
    "react-leaflet": "^2.8.0",
    "react-notification-alert": "0.0.12",
    "react-router-dom": "5.1.2",
    "react-scripts": "3.4.0",
    "reactstrap": "8.4.1",
    "sass": "^1.69.0"
  },
  "scripts": {
    "start": "npx cross-env CHOKIDAR_USEPOLLING=true NODE_OPTIONS=--openssl-legacy-provider NODE_PATH=./src react-scripts start",
    "build": "npx cross-env NODE_OPTIONS=--openssl-legacy-provider react-scripts build && gulp licenses",
    "test": "react-scripts test --env=jsdom",
    "eject": "react-scripts eject",
    "install:clean": "rm -rf node_modules/ && rm -rf package-lock.json && npm install && npm start",
    "compile-scss": "sass src/assets/scss/black-dashboard-react.scss src/assets/css/black-dashboard-react.css",
    "minify-sass": "sass src/assets/scss/black-dashboard-react.scss src/assets/css/black-dashboard-react.min.css --style=compressed",
    "map-sass": "sass src/assets/scss/black-dashboard-react.scss src/assets/css/black-dashboard-react.css --source-map"
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not ie <= 11",
    "not op_mini all"
  ],
  "optionalDependencies": {
    "@types/googlemaps": "3.39.3",
    "@types/markerclustererplus": "2.1.33",
    "eslint-plugin-flowtype": "3.13.0",
    "fsevents": "^2.3.3",
    "typescript": "3.8.3"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "gulp": "4.0.2",
    "gulp-append-prepend": "1.0.8"
  }
}
